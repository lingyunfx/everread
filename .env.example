# 复制为 .env 后修改。不要把 .env 提交到 Git。

# 网页访问端口：http://<NAS 地址>:8080
WEB_PORT=8080

# 数据目录（数据库与书籍文件都在这里，备份时备份整个目录）
DATA_PATH=./data

# 数据库
POSTGRES_USER=everread
POSTGRES_PASSWORD=请改成随机密码
POSTGRES_DB=everread

# JWT 签名密钥，生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=请改成随机长字符串
# 登录有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 首个管理员账号（仅在数据库中不存在时创建）
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=请改成强密码

# 单个文件上传上限（MB）与同时解析的书籍数
MAX_UPLOAD_MB=100
PARSE_CONCURRENCY=2
